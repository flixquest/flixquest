# Inputs to the scraper key. Create the real file with:
#   dart run tool/scraper_key.dart init
# Never commit .env.scraper or list it under assets in pubspec.yaml.
SCRAPER_PROD_KID=2026-11
SCRAPER_PROD_FRAGMENT=<base64, 32 random bytes>
SCRAPER_DEV_KID=dev-2026-11
SCRAPER_DEV_FRAGMENT=<base64, 32 random bytes>
SCRAPER_NATIVE_SECRET=<hex, 32 random bytes>
