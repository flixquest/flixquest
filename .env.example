# Compiled into the app with obfuscation by lib/core/config/app_secrets.dart. This
# file is never bundled, and must not be listed under assets in pubspec.yaml.
#
# Copy to .env. After any change, regenerate, because a plain build keeps the old
# values without warning:
#   dart run build_runner clean
#   dart run build_runner build --delete-conflicting-outputs
TMDB_API_KEY=
MIXPANEL_API_KEY=
FLIXQUEST_API_URL=https://scraper-1.flixquest.app

# Use a URL reachable by the target device, including its port when needed.
# /api/v1 is appended automatically if omitted. Build defines take precedence.
# Initial backend URL; Firebase Remote Config's laravel_api_url can replace it
# asynchronously after startup (users, billing, wallet, sync and other APIs).
LARAVEL_API_URL=

# Public OneSignal App ID (never the REST API key). Empty keeps the plain FCM
# client. A --dart-define=ONESIGNAL_APP_ID value takes precedence.
ONESIGNAL_APP_ID=
